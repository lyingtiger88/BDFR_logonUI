<Window x:Class="BDFR.LogonUI.Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BDFR.LogonUI.Demo"
        Title="BDFR LogonUI — Standalone Demo"
        MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#101827"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <LinearGradientBrush x:Key="Backdrop" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#172A46" Offset="0"/>
            <GradientStop Color="#263B57" Offset=".45"/>
            <GradientStop Color="#6A4651" Offset=".76"/>
            <GradientStop Color="#D07A52" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#253B536D"/>
            <Setter Property="BorderBrush" Value="#44FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="11,8"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolbarPrimaryButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="Background" Value="#2D7FF0"/>
            <Setter Property="BorderBrush" Value="#77B8FF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" Background="{StaticResource Backdrop}">
        <Image x:Name="BackgroundImage"
               Stretch="UniformToFill"
               Opacity=".98"
               Visibility="Collapsed"/>

        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#48030A12" Offset="0"/>
                    <GradientStop Color="#2607121E" Offset=".45"/>
                    <GradientStop Color="#69030A12" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Rectangle x:Name="EditGridOverlay"
                   Margin="24,112,24,28"
                   Opacity=".18"
                   IsHitTestVisible="False">
            <Rectangle.Fill>
                <DrawingBrush TileMode="Tile"
                              Viewport="0,0,24,24"
                              ViewportUnits="Absolute"
                              Viewbox="0,0,24,24"
                              ViewboxUnits="Absolute">
                    <DrawingBrush.Drawing>
                        <GeometryDrawing Brush="Transparent">
                            <GeometryDrawing.Pen>
                                <Pen Brush="#6A9CC8F4" Thickness=".55"/>
                            </GeometryDrawing.Pen>
                            <GeometryDrawing.Geometry>
                                <GeometryGroup>
                                    <LineGeometry StartPoint="24,0" EndPoint="24,24"/>
                                    <LineGeometry StartPoint="0,24" EndPoint="24,24"/>
                                </GeometryGroup>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Canvas x:Name="LayoutCanvas" Margin="24,112,24,28" ClipToBounds="True">
            <local:EditableWidgetHost x:Name="CalendarHost" WidgetId="calendar"
                                      Width="380" Height="465" DesignWidth="380" DesignHeight="465" MinWidth="190" MinHeight="233"
                                      Canvas.Left="20" Canvas.Top="18">
                <Grid FlowDirection="RightToLeft">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="270"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel>
                        <TextBlock Text="تقویم امروز" FontSize="24" FontWeight="SemiBold"/>
                        <TextBlock Text="شمسی • میلادی • قمری"
                                   Foreground="#AFC6DC"
                                   FontSize="10"
                                   VerticalAlignment="Center"
                                   Margin="10,4,0,0"/>
                    </DockPanel>

                    <Border Grid.Row="1"
                            Margin="0,14,0,12"
                            Padding="12"
                            Background="#35101825"
                            BorderBrush="#22FFFFFF"
                            BorderThickness="1"
                            CornerRadius="13">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="26"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="PersianMonthText"
                                       Text="مهر ۱۴۰۵"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>

                            <UniformGrid Grid.Row="1" Columns="7" Margin="0,8,0,0">
                                <TextBlock Text="ش" HorizontalAlignment="Center" Foreground="#BCD0E2"/>
                                <TextBlock Text="ی" HorizontalAlignment="Center" Foreground="#BCD0E2"/>
                                <TextBlock Text="د" HorizontalAlignment="Center" Foreground="#BCD0E2"/>
                                <TextBlock Text="س" HorizontalAlignment="Center" Foreground="#BCD0E2"/>
                                <TextBlock Text="چ" HorizontalAlignment="Center" Foreground="#BCD0E2"/>
                                <TextBlock Text="پ" HorizontalAlignment="Center" Foreground="#BCD0E2"/>
                                <TextBlock Text="ج" HorizontalAlignment="Center" Foreground="#E2A5A5"/>
                            </UniformGrid>

                            <UniformGrid x:Name="CalendarDaysGrid"
                                         Grid.Row="2"
                                         Columns="7"
                                         Rows="6"
                                         Margin="0,2,0,0"/>

                            <TextBlock x:Name="TodaySecondaryDatesText"
                                       Grid.Row="3"
                                       Text="Gregorian • Hijri"
                                       FontSize="9"
                                       Foreground="#AFC3D8"
                                       HorizontalAlignment="Center"
                                       Margin="0,5,0,0"
                                       FlowDirection="RightToLeft"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="2">
                        <TextBlock Text="برنامه‌های امروز"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,9"/>
                        <TextBlock Text="09:00   جلسه تیم محصول" Margin="0,5"/>
                        <TextBlock Text="11:30   بررسی طرح‌های جدید" Margin="0,5"/>
                        <TextBlock Text="15:00   پیگیری ایمیل‌ها" Margin="0,5"/>
                        <TextBlock Text="Provider رویدادها در گام بعدی به Broker متصل می‌شود"
                                   Foreground="#91ABC2"
                                   FontSize="10"
                                   Margin="0,9,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </local:EditableWidgetHost>

            <local:EditableWidgetHost x:Name="ClockHost" WidgetId="clock"
                                      Width="500" Height="220" DesignWidth="500" DesignHeight="220" MinWidth="250" MinHeight="110"
                                      Canvas.Left="500" Canvas.Top="25">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="ClockText"
                               Text="18:19"
                               FontSize="82"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               FlowDirection="LeftToRight"/>
                    <TextBlock x:Name="PersianDateText"
                               Text="چهارشنبه، ۱۵ مهر ۱۴۰۵"
                               FontSize="22"
                               HorizontalAlignment="Center"
                               Margin="0,-5,0,0"/>
                    <TextBlock x:Name="GregorianDateText"
                               Text="October 7, 2026"
                               FontSize="14"
                               Foreground="#D2DCE8"
                               HorizontalAlignment="Center"
                               Margin="0,6,0,0"
                               FlowDirection="LeftToRight"/>
                    <TextBlock x:Name="HijriDateText"
                               Text="٢٥ ربيع‌الثاني ١٤٤٨"
                               FontFamily="Traditional Arabic"
                               FontSize="13"
                               Foreground="#AFC3D8"
                               HorizontalAlignment="Center"
                               Margin="0,2,0,0"
                               FlowDirection="RightToLeft"/>
                </StackPanel>
            </local:EditableWidgetHost>

            <local:EditableWidgetHost x:Name="NotificationsHost" WidgetId="notifications"
                                      Width="390" Height="440" DesignWidth="390" DesignHeight="440" MinWidth="195" MinHeight="220"
                                      Canvas.Left="1080" Canvas.Top="18">
                <StackPanel FlowDirection="RightToLeft">
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock Text="اعلان‌ها" FontSize="24" FontWeight="SemiBold"/>
                        <TextBlock Text="حریم خصوصی فعال"
                                   FontSize="10"
                                   Foreground="#78E0B6"
                                   VerticalAlignment="Center"
                                   Margin="12,5,0,0"/>
                    </DockPanel>

                    <Border BorderBrush="#33FFFFFF" BorderThickness="0,0,0,1" Padding="0,12">
                        <StackPanel>
                            <TextBlock Text="Anahita Calendar" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="۲ یادآوری امروز • محتوای خصوصی مخفی"
                                       Foreground="#C7D3E0"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border BorderBrush="#33FFFFFF" BorderThickness="0,0,0,1" Padding="0,12">
                        <StackPanel>
                            <TextBlock Text="BDFR Sentinel" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="سیستم در وضعیت مطلوب است"
                                       Foreground="#C7D3E0"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Padding="0,12">
                        <StackPanel>
                            <TextBlock Text="Windows Update" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="اعلان عمومی نمونه"
                                       Foreground="#C7D3E0"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </local:EditableWidgetHost>

            <local:EditableWidgetHost x:Name="SystemHost" WidgetId="system-status-header"
                                      Width="640" Height="58" DesignWidth="640" DesignHeight="58" MinWidth="280" MinHeight="42"
                                      Canvas.Left="455" Canvas.Top="330">
                <DockPanel VerticalAlignment="Center">
                    <TextBlock Text="وضعیت سیستم"
                               FontSize="18"
                               FontWeight="SemiBold"
                               FlowDirection="RightToLeft"/>
                    <TextBlock x:Name="TelemetryStatusText"
                               Text="LIVE"
                               Foreground="#77E3B8"
                               FontSize="10"
                               Margin="12,5,0,0"
                               FlowDirection="LeftToRight"/>
                </DockPanel>
            </local:EditableWidgetHost>

            <local:EditableWidgetHost x:Name="CpuGaugeHost" WidgetId="gauge-cpu"
                                      Width="185" Height="165" DesignWidth="185" DesignHeight="165" MinWidth="96" MinHeight="82"
                                      Canvas.Left="465" Canvas.Top="405">
                <local:BDFRGauge x:Name="CpuGauge" Value="0" Label="CPU"/>
            </local:EditableWidgetHost>

            <local:EditableWidgetHost x:Name="RamGaugeHost" WidgetId="gauge-ram"
                                      Width="185" Height="165" DesignWidth="185" DesignHeight="165" MinWidth="96" MinHeight="82"
                                      Canvas.Left="680" Canvas.Top="405">
                <local:BDFRGauge x:Name="RamGauge" Value="0" Label="RAM"/>
            </local:EditableWidgetHost>

            <local:EditableWidgetHost x:Name="BatteryGaugeHost" WidgetId="gauge-battery"
                                      Width="185" Height="165" DesignWidth="185" DesignHeight="165" MinWidth="96" MinHeight="82"
                                      Canvas.Left="895" Canvas.Top="405">
                <local:BDFRGauge x:Name="BatteryGauge" Value="0" Label="باتری"/>
            </local:EditableWidgetHost>

            <local:EditableWidgetHost x:Name="QuickHost" WidgetId="quick-status"
                                      Width="270" Height="88" DesignWidth="270" DesignHeight="88" MinWidth="135" MinHeight="44"
                                      Canvas.Left="30" Canvas.Top="600">
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            FlowDirection="LeftToRight">
                    <TextBlock x:Name="NetworkStatusText" Text="Network …" FontSize="15" Margin="9,0"/>
                    <TextBlock Text="Display ✓" FontSize="15" Margin="9,0"/>
                    <TextBlock x:Name="PowerStatusText" Text="Power …" FontSize="15" Margin="9,0"/>
                    <TextBlock Text="FA" FontSize="15" Margin="9,0"/>
                </StackPanel>
            </local:EditableWidgetHost>

            <local:EditableWidgetHost x:Name="UnlockHost" WidgetId="unlock-hint"
                                      Width="420" Height="82" DesignWidth="420" DesignHeight="82" MinWidth="210" MinHeight="41"
                                      Canvas.Left="570" Canvas.Top="610">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="برای ورود واقعی هنوز به ویندوز متصل نشده"
                               HorizontalAlignment="Center"
                               FontSize="15"
                               Foreground="#E6EDF5"
                               FlowDirection="RightToLeft"/>
                    <TextBlock Text="STANDALONE SAFE MODE"
                               HorizontalAlignment="Center"
                               FontSize="9"
                               Margin="0,5,0,0"
                               Foreground="#92ACC4"
                               FlowDirection="LeftToRight"/>
                </StackPanel>
            </local:EditableWidgetHost>
        </Canvas>

        <Border VerticalAlignment="Top"
                HorizontalAlignment="Center"
                Margin="18"
                Padding="10,9"
                Background="#D0182433"
                BorderBrush="#55FFFFFF"
                BorderThickness="1"
                CornerRadius="16">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="0" Opacity=".35"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                <TextBlock x:Name="EditStateText"
                           Text="حالت ویرایش فعال"
                           Foreground="#88C7FF"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           FontSize="13"
                           Margin="10,0"/>

                <Button Style="{StaticResource ToolbarButton}" Content="ویرایش چیدمان" Click="EditMode_Click"/>
                <Button Style="{StaticResource ToolbarButton}" Content="ذخیره" Click="Save_Click"/>
                <Button Style="{StaticResource ToolbarButton}" Content="بازنشانی" Click="Reset_Click"/>
                <Button Style="{StaticResource ToolbarPrimaryButton}" Content="پایان و قفل ویرایش" Click="FinishEdit_Click"/>

                <Button Style="{StaticResource ToolbarButton}" Content="پس‌زمینه" Click="Background_Click"/>
                <Button x:Name="ElenaButton" Style="{StaticResource ToolbarButton}" Content="Elena: خاموش" Click="Elena_Click"/>
                <Button Style="{StaticResource ToolbarButton}" Content="پوشه فصل‌ها" Click="OpenBackgroundFolder_Click"/>

                <Button Style="{StaticResource ToolbarButton}" Content="تمام‌صفحه F11" Click="Fullscreen_Click"/>
                <Button Style="{StaticResource ToolbarButton}" Content="خروج" Click="Exit_Click" Background="#50333B49"/>
            </StackPanel>
        </Border>

        <Border HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="18"
                Padding="10,6"
                Background="#B20D1520"
                BorderBrush="#33FFFFFF"
                BorderThickness="1"
                CornerRadius="8">
            <StackPanel>
                <TextBlock Text="STANDALONE DEMO • Drag/Resize همه ویجت‌ها • Shift = تغییر نسبت آزاد"
                           Foreground="#C4D1DE"
                           FontSize="11"
                           FlowDirection="RightToLeft"/>
                <TextBlock x:Name="BackgroundModeText"
                           Text="پس‌زمینه پیش‌فرض"
                           Foreground="#89A8C2"
                           FontSize="10"
                           Margin="0,3,0,0"
                           FlowDirection="RightToLeft"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
