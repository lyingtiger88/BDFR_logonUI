<Window x:Class="BDFR.LogonUI.Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BDFR.LogonUI.Demo"
        Title="BDFR LogonUI — Standalone Demo"
        MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#101827"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <LinearGradientBrush x:Key="Backdrop" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#172A46" Offset="0"/>
            <GradientStop Color="#263B57" Offset=".45"/>
            <GradientStop Color="#6A4651" Offset=".76"/>
            <GradientStop Color="#D07A52" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#253B536D"/>
            <Setter Property="BorderBrush" Value="#44FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource Backdrop}">
        <Grid Background="#27081220"/>

        <Canvas x:Name="LayoutCanvas" Margin="24,112,24,28" ClipToBounds="True">
            <local:EditableWidgetHost x:Name="CalendarHost" WidgetId="calendar"
                                      Width="380" Height="465" MinWidth="290" MinHeight="300"
                                      Canvas.Left="20" Canvas.Top="18">
                <Grid FlowDirection="RightToLeft">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="تقویم امروز" FontSize="24" FontWeight="SemiBold"/>
                    <Border Grid.Row="1" Margin="0,18,0,14" Padding="14"
                            Background="#30101825" CornerRadius="13">
                        <StackPanel>
                            <TextBlock x:Name="PersianMonthText" Text="مهر ۱۴۰۵" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <UniformGrid Columns="7" Margin="0,12,0,0">
                                <TextBlock Text="ش" HorizontalAlignment="Center"/>
                                <TextBlock Text="ی" HorizontalAlignment="Center"/>
                                <TextBlock Text="د" HorizontalAlignment="Center"/>
                                <TextBlock Text="س" HorizontalAlignment="Center"/>
                                <TextBlock Text="چ" HorizontalAlignment="Center"/>
                                <TextBlock Text="پ" HorizontalAlignment="Center"/>
                                <TextBlock Text="ج" HorizontalAlignment="Center"/>
                            </UniformGrid>
                            <TextBlock Text="نمونه تقویم — اتصال به Calendar Provider در مرحله بعد"
                                       Foreground="#AFC3D8" Margin="0,14,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Row="2">
                        <TextBlock Text="برنامه‌های امروز" FontSize="18" FontWeight="SemiBold" Margin="0,2,0,12"/>
                        <TextBlock Text="09:00   جلسه تیم محصول" Margin="0,7"/>
                        <TextBlock Text="11:30   بررسی طرح‌های جدید" Margin="0,7"/>
                        <TextBlock Text="15:00   پیگیری ایمیل‌ها" Margin="0,7"/>
                    </StackPanel>
                </Grid>
            </local:EditableWidgetHost>

            <local:EditableWidgetHost x:Name="ClockHost" WidgetId="clock"
                                      Width="500" Height="220" MinWidth="330" MinHeight="160"
                                      Canvas.Left="500" Canvas.Top="25">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="ClockText" Text="18:19" FontSize="88" FontWeight="SemiBold"
                               HorizontalAlignment="Center" FlowDirection="LeftToRight"/>
                    <TextBlock x:Name="PersianDateText" Text="چهارشنبه، ۱۵ مهر ۱۴۰۵"
                               FontSize="23" HorizontalAlignment="Center" Margin="0,-5,0,0"/>
                    <TextBlock x:Name="GregorianDateText" Text="October 7, 2026"
                               FontSize="15" Foreground="#C8D2DF" HorizontalAlignment="Center" Margin="0,7,0,0"
                               FlowDirection="LeftToRight"/>
                </StackPanel>
            </local:EditableWidgetHost>

            <local:EditableWidgetHost x:Name="NotificationsHost" WidgetId="notifications"
                                      Width="390" Height="440" MinWidth="300" MinHeight="280"
                                      Canvas.Left="1080" Canvas.Top="18">
                <StackPanel FlowDirection="RightToLeft">
                    <TextBlock Text="اعلان‌ها" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16"/>
                    <Border BorderBrush="#33FFFFFF" BorderThickness="0,0,0,1" Padding="0,12">
                        <StackPanel>
                            <TextBlock Text="BDFR Calendar" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="۲ یادآوری امروز" Foreground="#C7D3E0" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border BorderBrush="#33FFFFFF" BorderThickness="0,0,0,1" Padding="0,12">
                        <StackPanel>
                            <TextBlock Text="BDFR Sentinel" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="سیستم در وضعیت مطلوب است" Foreground="#C7D3E0" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Padding="0,12">
                        <StackPanel>
                            <TextBlock Text="Windows Update" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="نمونه اعلان عمومی" Foreground="#C7D3E0" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </local:EditableWidgetHost>

            <local:EditableWidgetHost x:Name="SystemHost" WidgetId="system-status"
                                      Width="640" Height="245" MinWidth="390" MinHeight="185"
                                      Canvas.Left="455" Canvas.Top="330">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock Text="وضعیت سیستم" FontSize="18" FontWeight="SemiBold" FlowDirection="RightToLeft"/>
                        <TextBlock Text="  DEMO DATA" Foreground="#77E3B8" FontSize="11" Margin="10,4,0,0"/>
                    </DockPanel>
                    <UniformGrid Grid.Row="1" Columns="3" Margin="0,4,0,0">
                        <local:BDFRGauge Value="42" Label="CPU" Margin="5"/>
                        <local:BDFRGauge Value="68" Label="RAM" Margin="5"/>
                        <local:BDFRGauge Value="76" Label="باتری" Margin="5"/>
                    </UniformGrid>
                </Grid>
            </local:EditableWidgetHost>

            <local:EditableWidgetHost x:Name="QuickHost" WidgetId="quick-status"
                                      Width="270" Height="88" MinWidth="210" MinHeight="76"
                                      Canvas.Left="30" Canvas.Top="600">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center"
                            FlowDirection="LeftToRight">
                    <TextBlock Text="Wi‑Fi  ✓" FontSize="16" Margin="10,0"/>
                    <TextBlock Text="Display  ✓" FontSize="16" Margin="10,0"/>
                    <TextBlock Text="FA" FontSize="16" Margin="10,0"/>
                </StackPanel>
            </local:EditableWidgetHost>

            <local:EditableWidgetHost x:Name="UnlockHost" WidgetId="unlock-hint"
                                      Width="420" Height="82" MinWidth="310" MinHeight="72"
                                      Canvas.Left="570" Canvas.Top="610">
                <TextBlock Text="برای ورود واقعی هنوز به ویندوز متصل نشده — حالت آزمایشی"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="15" Foreground="#E6EDF5" FlowDirection="RightToLeft"/>
            </local:EditableWidgetHost>
        </Canvas>

        <Border VerticalAlignment="Top" HorizontalAlignment="Center"
                Margin="18" Padding="12,10"
                Background="#C6202B3A" BorderBrush="#55FFFFFF" BorderThickness="1" CornerRadius="16">
            <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                <TextBlock x:Name="EditStateText" Text="حالت ویرایش فعال" Foreground="#88C7FF"
                           VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14" Margin="12,0"/>
                <Button Style="{StaticResource ToolbarButton}" Content="حالت ویرایش" Click="EditMode_Click"/>
                <Button Style="{StaticResource ToolbarButton}" Content="ذخیره چیدمان" Click="Save_Click"/>
                <Button Style="{StaticResource ToolbarButton}" Content="بازنشانی" Click="Reset_Click"/>
                <Button Style="{StaticResource ToolbarButton}" Content="پایان و قفل ویرایش" Click="FinishEdit_Click"
                        Background="#2D7FF0"/>
                <Button Style="{StaticResource ToolbarButton}" Content="تمام‌صفحه F11" Click="Fullscreen_Click"/>
                <Button Style="{StaticResource ToolbarButton}" Content="خروج از تست" Click="Exit_Click"
                        Background="#50333B49"/>
            </StackPanel>
        </Border>

        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Margin="18" Padding="10,6" Background="#AA0D1520" CornerRadius="8">
            <TextBlock Text="STANDALONE DEMO — هیچ تغییری در Logon ویندوز ایجاد نمی‌شود"
                       Foreground="#B9C8D8" FontSize="12" FlowDirection="RightToLeft"/>
        </Border>
    </Grid>
</Window>
