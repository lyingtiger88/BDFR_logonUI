<Application x:Class="BDFR.LogonUI.Demo.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:BDFR.LogonUI.Demo">
    <Application.Resources>
        <SolidColorBrush x:Key="GlassSurfaceBrush" Color="#A8182433"/>
        <SolidColorBrush x:Key="GlassBorderBrush" Color="#52FFFFFF"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <Style TargetType="{x:Type local:EditableWidgetHost}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type local:EditableWidgetHost}">
                        <Grid>
                            <Border x:Name="PART_Surface"
                                    Background="{StaticResource GlassSurfaceBrush}"
                                    BorderBrush="{StaticResource GlassBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="20">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000"
                                                      BlurRadius="26"
                                                      ShadowDepth="0"
                                                      Opacity=".42"/>
                                </Border.Effect>
                                <Viewbox Stretch="Uniform"
                                         StretchDirection="Both"
                                         HorizontalAlignment="Stretch"
                                         VerticalAlignment="Stretch">
                                    <Grid Width="{TemplateBinding DesignWidth}"
                                          Height="{TemplateBinding DesignHeight}">
                                        <ContentPresenter
                                            Content="{TemplateBinding Content}"
                                            ContentTemplate="{TemplateBinding ContentTemplate}"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            Margin="18"/>
                                    </Grid>
                                </Viewbox>
                            </Border>

                            <Rectangle x:Name="PART_Selection"
                                       Margin="-4"
                                       RadiusX="22" RadiusY="22"
                                       Stroke="#65B7FF"
                                       StrokeThickness="2"
                                       StrokeDashArray="4 3"
                                       IsHitTestVisible="False"
                                       Visibility="Collapsed"/>

                            <Thumb x:Name="PART_ResizeThumb"
                                   Width="22" Height="22"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,-8,-8"
                                   Cursor="SizeNWSE"
                                   Background="#2F8CFF"
                                   Visibility="Collapsed">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="White"
                                                BorderThickness="2"
                                                CornerRadius="11"/>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsEditMode" Value="True"/>
                                    <Condition Property="IsLayoutLocked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="PART_Selection" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="PART_ResizeThumb" Property="Visibility" Value="Visible"/>
                            </MultiTrigger>

                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="PART_Selection" Property="StrokeThickness" Value="3"/>
                                <Setter TargetName="PART_Selection" Property="Stroke" Value="#8AC8FF"/>
                            </Trigger>

                            <Trigger Property="IsLayoutLocked" Value="True">
                                <Setter TargetName="PART_Surface" Property="BorderBrush" Value="#34FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
